# This repository carries the release tree only: the engine, the application,
# the plugin, and the README. Everything below stays on the development
# machine.

# Build + install outputs
build/
install/
_juc*/
*.o
*.obj

# Reference material. Third-party documentation that is not ours to
# redistribute, plus upstream checkouts carrying their own .git.
specs/

# Development tooling and internal notes, not part of a release. The test
# suite is not among them: it needs no sample library, runs in a second, and
# is what catches the faults this project keeps finding by ear.
docs/
build-scripts/
apps/mp-render/
apps/mp-validate-odf/
PROJECT_SUMMARY.md
README_BUILD.md
ROADMAP_M1-M4.md

# The local tooling repository. Same working tree, different history: it
# versions the development tree this repository deliberately leaves out, so
# that work still has a baseline to diff and revert against. It has no remote
# and never pushes.  git tool <command>
/.git-local/

# CMake user overrides
CMakeUserPresets.json

# Session and editor clutter
.claude/
.vs/
.vscode/
.idea/
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Plugin binaries
*.vst3/
*.component/
*.lv2/

# Renders, logs and working screenshots. Anything derived from a licensed
# sample set is not ours to ship; the published gallery in screenshots/ is
# captured deliberately.
*.wav
*.log
/console-*.png
/settings-*.png

# OS clutter
.DS_Store
Thumbs.db

# Secrets. Never committed, to either repo.
.env
.env.*
*.key

# The demonstration recording is fetched from the release at deploy time.
site/recital.mp4

# Nonfree binaries (bundled in releases, never checked into source control)
unrar
unrar.exe
